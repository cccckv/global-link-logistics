generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(uuid())
  email              String?                 @unique
  passwordHash       String
  name               String
  phone              String                  @unique
  company            String?
  userType           UserType                @default(CUSTOMER)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  userRole           UserRoleEnum            @default(USER)
  shippingMarks      String[]                @default([])
  batchImportTasks   BatchImportTask[]
  recipientAddresses OrderRecipientAddress[] @relation("UserRecipientAddresses")
  overseasAddresses  OrderOverseasAddress[]  @relation("UserOverseasAddresses")
  payments           Payment[]
  markedOrders       QuickOrder[]            @relation("MarkUser")
  quickOrders        QuickOrder[]
  roles              UserRole[]
  v2Waybills         Waybill[]               @relation("UserWaybills")
}

model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  type      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, type, verified])
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  permissions String[]
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model QuickOrder {
  id                 String                   @id @default(uuid())
  orderNumber        String                   @unique
  userId             String
  orderType          QuickOrderType
  warehouse          String?
  destination        String
  note               String?
  userMark           String?
  mark               String?
  originPort         String?
  destinationPort    String?
  voyageNumber       String?
  airWaybillNumber   String?
  billOfLading                String?
  containerNumber             String?
  bookingChannel              String?
  customsDeclarationChannel   String?
  customsClearanceChannel     String?
  loadingDate        DateTime?
  eta                DateTime?
  totalShippingDays  Int?
  batchTaskId        String?
  status             QuickOrderStatus         @default(LOADING)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  recipientAddressId String
  overseasAddressId  String?
  markUserId         String?
  shippedAt          DateTime?
  receivedAt         DateTime?
  overseasReceivedAt DateTime?
  containers         OrderContainer[]
  declarations       OrderDeclaration[]
  paymentCollections OrderPaymentCollection[]
  paymentVouchers    OrderPaymentVoucher[]
  payment            Payment?
  batchTask          BatchImportTask?         @relation(fields: [batchTaskId], references: [id])
  markUser           User?                    @relation("MarkUser", fields: [markUserId], references: [id])
  recipientAddress   OrderRecipientAddress    @relation("OrderRecipientAddress", fields: [recipientAddressId], references: [id])
  overseasAddress    OrderOverseasAddress?    @relation("OrderOverseasAddress", fields: [overseasAddressId], references: [id])
  user               User                     @relation(fields: [userId], references: [id])
  shipment           Shipment?

  @@index([userId, orderType, status, createdAt(sort: Desc)])
  @@index([markUserId, orderType, status, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@index([batchTaskId])
  @@index([createdAt(sort: Desc)])
}

model OrderRecipientAddress {
  id        String       @id @default(uuid())
  userId    String
  name      String
  company   String?
  phone     String
  region    String?
  address   String
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation("UserRecipientAddresses", fields: [userId], references: [id], onDelete: Cascade)
  orders    QuickOrder[] @relation("OrderRecipientAddress")

  @@unique([userId, phone])
  @@unique([userId, phone, name])
  @@index([userId, isDefault])
  @@index([userId, updatedAt])
}

model OrderOverseasAddress {
  id        String       @id @default(uuid())
  userId    String
  name      String
  company   String?
  phone     String
  region    String?
  address   String
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation("UserOverseasAddresses", fields: [userId], references: [id], onDelete: Cascade)
  orders    QuickOrder[] @relation("OrderOverseasAddress")

  @@unique([userId, phone])
  @@unique([userId, phone, name])
  @@index([userId, isDefault])
  @@index([userId, updatedAt])
}

model OrderDeclaration {
  id                 String                   @id @default(uuid())
  orderId            String
  trackingNumber     String?
  productName        String
  quantity           Int                      @default(1)
  length             Decimal?                 @db.Decimal(8, 2)
  width              Decimal?                 @db.Decimal(8, 2)
  height             Decimal?                 @db.Decimal(8, 2)
  weight             Decimal                  @db.Decimal(10, 3)
  cnyUnitPrice       Decimal?                 @db.Decimal(10, 2)
  createdAt          DateTime                 @default(now())
  phpUnitPrice       Decimal?                 @db.Decimal(10, 2)
  channelUnitPriceCny Decimal?                @db.Decimal(10, 2)
  channelUnitPricePhp Decimal?                @db.Decimal(10, 2)
  order              QuickOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productName])
}

model OrderContainer {
  id            String        @id @default(uuid())
  orderId       String
  containerType String
  quantity      Int
  weight        Decimal?      @db.Decimal(10, 2)
  productsJson  String?
  createdAt     DateTime      @default(now())
  order         QuickOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BatchImportTask {
  id           String            @id @default(uuid())
  userId       String
  fileUrl      String
  fileName     String?
  fileSize     Int?
  warehouse    String
  destination  String
  status       BatchImportStatus @default(UPLOADING)
  totalRows    Int               @default(0)
  successCount Int               @default(0)
  failedCount  Int               @default(0)
  errorLog     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id])
  orders       QuickOrder[]

  @@index([userId, status, createdAt(sort: Desc)])
}

model Shipment {
  id               String          @id @default(uuid())
  orderId          String?         @unique
  trackingNumber   String          @unique
  carrier          String
  originPort       String?
  destinationPort  String?
  departureDate    DateTime?
  arrivalDate      DateTime?
  estimatedArrival DateTime?
  currentLocation  String?
  currentLat       Float?
  currentLng       Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quickOrderId     String?         @unique
  quickOrder       QuickOrder?     @relation(fields: [quickOrderId], references: [id])
  events           TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  status      String
  description String
  location    String
  lat         Float?
  lng         Float?
  timestamp   DateTime
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String?       @unique
  userId          String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  paymentMethod   String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  quickOrderId    String?       @unique
  quickOrder      QuickOrder?   @relation(fields: [quickOrderId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model OrderPaymentCollection {
  id                  String     @id @default(uuid())
  orderId             String     @unique
  totalPieces         Int        @default(0)
  totalVolume         Decimal?   @db.Decimal(12, 4)
  totalWeight         Decimal?   @db.Decimal(10, 3)
  receivableAmount    Decimal    @db.Decimal(10, 2)
  payableAmount       Decimal    @db.Decimal(10, 2)
  receivableCurrency  String     @default("CNY")
  payableCurrency     String     @default("PHP")
  carPickupReceivable Decimal?   @db.Decimal(10, 2)
  carPickupActual     Decimal?   @db.Decimal(10, 2)
  oceanFreight        Decimal?   @db.Decimal(10, 2)
  bookingFee          Decimal?   @db.Decimal(10, 2)
  portGateFee         Decimal?   @db.Decimal(10, 2)
  truckingFee         Decimal?   @db.Decimal(10, 2)
  customsCertFee      Decimal?   @db.Decimal(10, 2)
  thcOverstayFee      Decimal?   @db.Decimal(10, 2)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  order               QuickOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model OrderPaymentVoucher {
  id          String             @id @default(uuid())
  orderId     String
  fileUrl     String
  fileName    String?
  fileType    String?
  voucherType OrderVoucherType   @default(PAYMENT)
  uploadedAt  DateTime           @default(now())
  order       QuickOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, voucherType])
}

enum UserType {
  CUSTOMER
  EMPLOYEE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum QuickOrderType {
  SEA_LCL
  AIR
  LAND
  SEA_FCL
  PARCEL
  BATCH
}

enum QuickOrderStatus {
  LOADING
  SAILING
  ARRIVED
  CUSTOMS
  DISPATCHING
}

enum BatchImportStatus {
  UPLOADING
  PARSING
  COMPLETED
  FAILED
  PARTIAL
}

enum UserRoleEnum {
  ADMIN
  USER
  SALES
  FINANCE
}

enum OrderVoucherType {
  PAYMENT
  RECEIPT
  OVERSEAS_RECEIPT
}


// ==========================================
// V2 REFACTORED MODELS (全新独立演进架构)
// ==========================================

model Customer {
  id                 String            @id @default(uuid())
  clientCode         String            @unique // 客户编码/唛头 (如 WH-ZZY-FLB, WH-10115)
  name               String            // 客户名称/企业名
  phone              String?
  email              String?
  company            String?
  destinationCountry String?           // 常用目的国
  destinationPort    String?           // 常用目的港
  defaultWarehouse   String?           // 常用起运仓 (广州/龙岩/义乌)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  addresses          CustomerAddress[]
  waybills           Waybill[]
}

model CustomerAddress {
  id           String        @id @default(uuid())
  customerId   String
  addressType  AddressType   @default(OVERSEAS_RECIPIENT) // DOMESTIC_SENDER | OVERSEAS_RECIPIENT
  name         String        // 联系人姓名
  phone        String        // 联系电话
  company      String?       // 公司名称
  country      String?       // 国家
  region       String?       // 省/市/地区
  address      String        // 详细地址
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, addressType, isDefault])
}

enum AddressType {
  DOMESTIC_SENDER
  OVERSEAS_RECIPIENT
}

model Waybill {
  id                 String            @id @default(uuid())
  waybillNo          String            @unique // 系统运单号
  orderType          ShipmentType                // SEA_LCL | AIR | SEA_FCL | LAND
  status             WaybillStatus     @default(DRAFT)
  
  // 客户与基础信息
  customerId         String?
  userMark           String            // 客户编码/唛头镜像
  operatorId         String?           // 录入/经办业务员
  originWarehouse    String?           // 起运仓/渠道 (广州/龙岩/义乌等)
  destinationCountry String            // 目的国 (菲律宾/印尼/泰国等)
  destinationPort    String?           // 目的港口 (马尼拉南港/北港等)
  expressNo          String?           // 运递单号/专线单号 (如 FLY100002162)
  customsType        String?           // 报关/货品通道 (如 普货双清 / 退税报关 / 敏感特货)
  forwarderChannel   String?           // 承运服务商/同行外发渠道 (如 自营专线 / 中外运 / 菲通 / 天帆)
  voyageNumber       String?           // 船名/航次 (海运拼箱用)
  airWaybillNo       String?           // 空运单号 AWB (空运专用)
  note               String?           // 订单备注

  // 地址快照 (创建时从客户地址簿复制，支持随时微调)
  recipientName      String?
  recipientPhone     String?
  recipientCompany   String?
  recipientAddress   String?
  recipientRegion    String?

  overseasName       String?
  overseasPhone      String?
  overseasCompany    String?
  overseasAddress    String?
  overseasRegion     String?

  // 关键时间节点
  inboundDate        DateTime?         // 国内入库时间
  loadingDate        DateTime?         // 装柜/起飞时间
  sailingDate        DateTime?         // 开船时间
  eta                DateTime?         // 预计到港时间
  clearanceDate      DateTime?         // 清关完成时间
  signedDate         DateTime?         // 海外签收时间

  // 关联物理集装箱 (海运拼箱为 N:1 挂载；整柜为 1:1 绑定)
  containerId        String?
  containerMaster    ContainerMaster?  @relation("ContainerWaybills", fields: [containerId], references: [id])

  // 财务汇总缓存
  totalPieces        Int               @default(0)
  totalPayableCbm    Decimal?          @db.Decimal(12, 4)
  totalReceivableCbm Decimal?          @db.Decimal(12, 4)
  totalWeightKg      Decimal?          @db.Decimal(12, 3)
  receivableAmount   Decimal?          @db.Decimal(12, 2)
  payableAmount      Decimal?          @db.Decimal(12, 2)
  profitAmount       Decimal?          @db.Decimal(12, 2)
  isFixedPrice       Boolean           @default(false) // 是否一口价
  fixedPriceAmount   Decimal?          @db.Decimal(12, 2) // 一口价协议金额

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  customer           Customer?         @relation(fields: [customerId], references: [id])
  operator           User?             @relation("UserWaybills", fields: [operatorId], references: [id])
  items              WaybillItem[]
  fees               WaybillFee[]
  attachments        WaybillAttachment[]

  @@index([orderType, status, createdAt(sort: Desc)])
  @@index([userMark])
  @@index([containerId])
}

enum ShipmentType {
  SEA_LCL     // 海运拼柜
  AIR         // 空运快递
  SEA_FCL     // 海运整柜
  LAND        // 陆运
}

enum WaybillStatus {
  DRAFT       // 草稿/已预报
  INBOUND     // 已入库/已核量
  LOADED      // 已装柜/已配载
  IN_TRANSIT  // 运输在途/开船/起飞
  CUSTOMS     // 目的港清关中
  DISPATCHING // 海外派送中/拆箱
  DELIVERED   // 已签收完成
  CANCELLED   // 已取消
}

enum CurrencyType {
  CNY
  PHP
  USD
}

model WaybillItem {
  id                  String       @id @default(uuid())
  waybillId           String
  itemIndex           Int          @default(1)
  trackingNumber      String?      // 国内送仓快递单号
  productName         String       // 中文品名
  quantity            Int          @default(1) // 实际实收件数 (结算基准)
  
  // 阶段 1：客户初始预报快照 (可随时修改纠偏，保留原始基准)
  estimatedQuantity   Int?         // 预报件数
  estimatedLength     Decimal?     @db.Decimal(8, 2) // 预报长 (cm)
  estimatedWidth      Decimal?     @db.Decimal(8, 2) // 预报宽 (cm)
  estimatedHeight     Decimal?     @db.Decimal(8, 2) // 预报高 (cm)
  estimatedWeight     Decimal?     @db.Decimal(10, 3) // 预报单件重量 (kg)
  estimatedVolume     Decimal?     @db.Decimal(10, 4) // 预报总算方体积 (m³)

  // 阶段 2：仓库现场实测数据 (运费结算与装柜配载基准)
  length              Decimal?     @db.Decimal(8, 2) // 实测长 cm
  width               Decimal?     @db.Decimal(8, 2) // 实测宽 cm
  height              Decimal?     @db.Decimal(8, 2) // 实测高 cm
  payableVolume       Decimal?     @db.Decimal(10, 4) // 实测体积 m³
  receivableVolume    Decimal?     @db.Decimal(10, 4) // 计费体积 m³
  
  // 重量 (空运核心)
  unitWeight          Decimal?     @db.Decimal(10, 3) // 实测单重 kg
  totalWeight         Decimal?     @db.Decimal(10, 3) // 实测总重 kg

  // 单价
  receivableCurrency  CurrencyType @default(CNY)
  receivableUnitPrice Decimal?     @db.Decimal(10, 2) // 应收单价
  payableCurrency     CurrencyType @default(CNY)
  payableUnitPrice    Decimal?     @db.Decimal(10, 2) // 应付单价

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  waybill             Waybill      @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  @@index([waybillId])
  @@index([trackingNumber])
}

model WaybillFee {
  id                 String       @id @default(uuid())
  waybillId          String
  feeName            String       // 费用科目 (如海运费/报关费/国内车费/一口价补差)
  feeDirection       FeeDirection // RECEIVABLE | PAYABLE
  amount             Decimal      @db.Decimal(10, 2)
  currency           CurrencyType @default(CNY)
  exchangeRate       Decimal      @default(1.0) @db.Decimal(8, 4) // 折算人民币汇率
  amountInCny        Decimal      @db.Decimal(10, 2)              // 折合人民币
  isPaid             Boolean      @default(false)
  paidAt             DateTime?
  note               String?
  createdAt          DateTime     @default(now())

  waybill            Waybill      @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  @@index([waybillId, feeDirection])
}

enum FeeDirection {
  RECEIVABLE
  PAYABLE
}

model WaybillAttachment {
  id                 String          @id @default(uuid())
  waybillId          String
  attachmentType     AttachmentType  @default(OTHER)
  fileUrl            String
  fileName           String?
  fileSize           Int?
  fileType           String?
  uploadedAt         DateTime        @default(now())

  waybill            Waybill         @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  @@index([waybillId, attachmentType])
}

enum AttachmentType {
  PICKUP_SCREENSHOT
  CUSTOMS_SLIP
  SIGN_IMAGE
  BILL_OF_LADING
  CERT_OF_ORIGIN
  PAYMENT_PROOF
  OTHER
}

model ContainerMaster {
  id                 String          @id @default(uuid())
  containerNo        String          @unique // 集装箱柜号 (如 MILU6019768 / 广62柜)
  containerType      String?         // 20GP | 40GP | 40HQ | 45HQ
  blNumber           String?         // 提单号 (B/L)
  carrier            String?         // 船司 (如中远海运/万海/马士基)
  vesselVoyage       String?         // 船名/航次
  mmsi               String?         // 船舶 MMSI
  imo                String?         // 船舶 IMO
  
  // 航线与港口
  originPort         String?         // 起运港口
  destinationPort    String?         // 清关目的港
  
  // 渠道链条
  bookingChannel     String?         // 订舱渠道
  customsChannel     String?         // 报关渠道
  clearanceChannel   String?         // 清关渠道
  truckingChannel    String?         // 拖车渠道

  // 目的港送柜拖车信息 (海关提柜 ➔ 目的地仓库)
  truckPlateNo       String?         // 拖车车牌号码
  driverName         String?         // 司机姓名
  driverPhone        String?         // 司机联系电话
  truckingDate       DateTime?       // 订车时间 / 提柜起运时间
  destArrivedDate    DateTime?       // 送达目的地仓库时间

  // 时间节点
  loadingDate        DateTime?       // 装柜时间
  sailingDate        DateTime?       // 开船时间 (ETD)
  eta                DateTime?       // 预计到港时间 (ETA)
  clearanceDate      DateTime?       // 清关送达时间
  totalShippingDays  Int?            // 总航运天数
  inspectStatus      String?         // 查验状态

  // 状态
  status             ContainerStatus @default(LOADING)
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  waybills           Waybill[]       @relation("ContainerWaybills")
  fees               ContainerFee[]
  attachments        ContainerAttachment[]

  @@index([containerNo])
  @@index([status])
}

enum ContainerStatus {
  LOADING
  SAILING
  ARRIVED
  CUSTOMS
  DISPATCHING
  COMPLETED
}

model ContainerFee {
  id                 String              @id @default(uuid())
  containerId        String
  feeSubject         ContainerFeeSubject
  feeDirection       FeeDirection        @default(PAYABLE)
  amount             Decimal             @db.Decimal(10, 2)
  currency           CurrencyType        @default(CNY)
  exchangeRate       Decimal             @default(1.0) @db.Decimal(8, 4)
  amountInCny        Decimal             @db.Decimal(10, 2)
  note               String?
  createdAt          DateTime            @default(now())

  container          ContainerMaster     @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId, feeSubject])
}

enum ContainerFeeSubject {
  BOOKING_FEE
  PORT_SURCHARGE
  TRUCKING_FEE
  CUSTOMS_FEE
  CLEARANCE_FEE
  THC_OVERSTAY_FEE
  DEST_TRUCKING_FEE
  HOLIDAY_TIP
  CLIENT_QUOTATION
  OTHER_FEE
}

model ContainerAttachment {
  id                 String          @id @default(uuid())
  containerId        String
  fileUrl            String
  fileName           String?
  fileType           String?
  uploadedAt         DateTime        @default(now())

  container          ContainerMaster @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId])
}

enum ChannelCategory {
  SEA_LCL        // 海运拼箱专线渠道
  AIR            // 空运专线渠道
  FCL_BOOKING    // 整柜 - 订舱渠道 (船司/代理)
  FCL_CUSTOMS    // 整柜 - 报关渠道 (出口报关行)
  FCL_CLEARANCE  // 整柜 - 清关渠道 (目的港清关行)
  FCL_TRUCKING   // 整柜 - 拖车渠道 (卡车车队)
}

model ShippingChannel {
  id            String          @id @default(uuid())
  category      ChannelCategory // 渠道所属分类
  name          String          // 渠道/服务商名称
  code          String?         // 简码/代号
  contactPerson String?         // 联系人
  contactPhone  String?         // 联系电话
  isDefault     Boolean         @default(false) // 是否为该分类下的默认推荐选项
  isActive      Boolean         @default(true)  // 启用状态
  sortOrder     Int             @default(0)     // 排序权重
  note          String?         // 备注说明
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, isActive])
}

model OriginWarehouse {
  id             String   @id @default(uuid())
  code           String   @unique // 仓库标识码 (如 GZ-01, LY-01, YW-01)
  name           String   // 仓库全称 (如 "广州白云集运总仓")
  shortName      String   // 简称 (如 "广州仓")
  contactName    String   // 仓库收货负责人/联系人 (如 "广州仓收货组")
  contactPhone   String   // 仓库联系/收货电话 (如 "13800000000")
  province       String?  // 省份
  city           String?  // 城市
  address        String   // 仓库详细收货地址
  receivingHours String?  // 营业收货时间 (如 "09:00 - 21:00")
  isDefault      Boolean  @default(false) // 是否系统默认仓
  isActive       Boolean  @default(true)  // 启用状态
  sortOrder      Int      @default(0)     // 排序权重
  note           String?  // 备注/送仓指引说明
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
}

